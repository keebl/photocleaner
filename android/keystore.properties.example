# Copy to android/keystore.properties (git-ignored) and fill in the upload key details.
# Never commit the real file or the keystore. storeFile is an absolute path (no ~) or a
# path relative to android/; docs/PLAYSTORE.md creates the key in ~/keys/.
storeFile=/Users/YOUR_USER/keys/photocleaner-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

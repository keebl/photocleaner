<?xml version="1.0" encoding="utf-8"?>
<!--
  App data holds MediaStore ids (trash, kept list, hash cache) that are meaningless on
  another device, so nothing is backed up or transferred (spec: Data and privacy).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
